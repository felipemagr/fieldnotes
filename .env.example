# Earpiece settings. Copy to .env and change what you need. Never put ANTHROPIC_API_KEY here.

# Brain
EARPIECE_MODEL=haiku                       # or sonnet
EARPIECE_DOCS_URL=https://docs.fence.finance/
EARPIECE_DOCS_TTL_DAYS=7
EARPIECE_DOCS_MAX_PAGES=40
EARPIECE_LLM_TIMEOUT_S=30
EARPIECE_REPORT_TIMEOUT_S=120

# Audio: leave the mic empty to use the default input
# EARPIECE_MIC_DEVICE=MacBook Pro Microphone
EARPIECE_CLIENT_DEVICE=BlackHole 2ch
EARPIECE_END_OF_TURN_MS=700
EARPIECE_MIN_UTTERANCE_S=0.5
EARPIECE_LANGUAGE=en
EARPIECE_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo

# Trigger
EARPIECE_TRIGGER_MIN_WORDS=15
EARPIECE_DEBOUNCE_S=2

# Records
EARPIECE_KEEP_TRANSCRIPTS=false
EARPIECE_RETENTION_DAYS=7
EARPIECE_PORT=8765
