# Fieldnotes settings. Copy to .env and change what you need. Never put ANTHROPIC_API_KEY here.

# Brain
FIELDNOTES_MODEL=haiku                       # live board, or sonnet
FIELDNOTES_REPORT_MODEL=opus                 # post-call report
FIELDNOTES_DOCS_URL=https://docs.fence.finance/
FIELDNOTES_DOCS_MAX_PAGES=40
FIELDNOTES_LLM_TIMEOUT_S=30
FIELDNOTES_REPORT_TIMEOUT_S=120

# Audio: leave the mic empty to use the default input
# FIELDNOTES_MIC_DEVICE=MacBook Pro Microphone
FIELDNOTES_CLIENT_DEVICE=BlackHole 2ch
FIELDNOTES_END_OF_TURN_MS=700
FIELDNOTES_MIN_UTTERANCE_S=0.5
FIELDNOTES_LANGUAGE=en
FIELDNOTES_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo

# Trigger
FIELDNOTES_TRIGGER_MIN_WORDS=15
FIELDNOTES_DEBOUNCE_S=2

# Records
FIELDNOTES_KEEP_TRANSCRIPTS=false
FIELDNOTES_RETENTION_DAYS=7
FIELDNOTES_PORT=8765
